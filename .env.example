# LLM API configuration
# Copy this file to .env and fill in real values.
# Environment variables override values in .env.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
# Seconds an answer stream may stay silent before it is aborted as stalled
# (whole seconds; 0 disables the idle watchdog).
# LLM_IDLE_TIMEOUT=90

# Web gateway JWT signing secret (min 32 chars). Required to start :web.
# Generate:  (64 hex chars from a CSPRNG is fine)
AGENT_JWT_SECRET=replace-with-a-long-random-secret-value

# Optional: access-token lifetime (default 2h). Sessions survive this as long as
# they stay active — see AGENT_REFRESH_IDLE_TIMEOUT for the real logout rule.
# AGENT_JWT_TTL=2h

# Optional: log the session out after this long with no authenticated request
# (default 24h). Any API call or token refresh counts as activity.
# AGENT_REFRESH_IDLE_TIMEOUT=24h

# Optional: public URL of the web UI, used to build the clickable link in
# forgot-password mails (e.g. https://assistant.example.com). Unset keeps the
# mail to the paste-able reset token only.
# AGENT_RESET_BASE_URL=

# PostgreSQL persistence. Required when AGENT_STORE=postgres (the default).
# The password has no default — put it here, never in source or application.yml.
# The URL must state its TLS intent; use sslmode=require unless the database is local.
AGENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/postgres?sslmode=require
AGENT_DB_USERNAME=postgres
AGENT_DB_PASSWORD=replace-with-your-database-password

# Persistence backend: postgres (default, survives restarts) or memory
# (process-local; history is lost on restart — never use in production).
# AGENT_STORE=postgres

# Optional: customise conversation-memory compression thresholds (tokens).
# AGENT_MEMORY_ENABLED=true
# AGENT_MEMORY_MAX_TOKENS=500000
# AGENT_MEMORY_KEEP_TOKENS=4096

# Optional: run the memory summariser on a different model than the chat
# default. Model name alone is enough when only one provider offers it;
# set the provider id too when the name is ambiguous. Falls back to the
# default model when the pair is not on offer. Use an instruction-following
# model — flash-tier models tend to continue the folded transcript instead
# of writing the summary (verified: mimo-v2.6-pro ok, mimo-v2.6-flash not).
# AGENT_MEMORY_SUMMARY_PROVIDER=
# AGENT_MEMORY_SUMMARY_MODEL=

# Content moderation (web defaults on; the CLI defaults off — set
# AGENT_MODERATION_ENABLED=true to turn it on there too).
# mode=flag: gray release — findings are audited, nothing is intercepted.
# mode=block: enforce the disposition matrix (block / redact / flag).
# AGENT_MODERATION_ENABLED=true
# AGENT_MODERATION_MODE=block
# Lexicon source: classpath:moderation/lexicon.json (skeleton) or a file path;
# file paths are hot-reloaded when the file changes.
# AGENT_MODERATION_LEXICON_PATH=classpath:moderation/lexicon.json
# L2 classifier: prefer a flash-tier model; empty falls back to the default chat model.
# AGENT_MODERATION_LLM_ENABLED=true
# AGENT_MODERATION_LLM_PROVIDER=
# AGENT_MODERATION_LLM_MODEL=
# AGENT_MODERATION_LLM_TIMEOUT_MS=800

# Tool artifact downloads (/api/v1/files/**) and the office-mcp upload target.
# OFFICE_STORE=local (default) reads agent.files.dir; OFFICE_STORE=oss proxies
# downloads from Aliyun OSS, which the office-mcp server uploads to under the
# same prefix. For an ECS in the same region prefer the internal endpoint
# (https://oss-cn-shanghai-internal.aliyuncs.com) to keep traffic free.
#
# NOTE: mcp.json forwards these to the office-mcp process via ${...}
# placeholders — every key must exist here even when empty, or the MCP config
# fails to load and no tools connect.
OFFICE_STORE=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_PREFIX=office/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Web search tool (the model's web_search, backed by the Tavily API).
# Get a key at https://tavily.com — without one the tool is simply not
# registered. Optional overrides shown with their defaults.
# TAVILY_API_KEY=tvly-your-key-here
# AGENT_WEBSEARCH_ENABLED=true
# AGENT_WEBSEARCH_BASE_URL=https://api.tavily.com
# AGENT_WEBSEARCH_MAX_RESULTS=5
# AGENT_WEBSEARCH_OUTPUT_LIMIT=8000
# AGENT_WEBSEARCH_TIMEOUT=30
# AGENT_WEBSEARCH_INCLUDE_ANSWER=true

# Per-user exec isolation: every account gets <root>/<owner>/ as its private
# workspace (workdir root + own gh/gcloud/aws config dirs + own credentials from
# 设置 → 工具凭据). Strongly recommended with more than one user; empty keeps the
# legacy shared working directory. On the server pick a durable path, e.g.
# /opt/personal-assistant/workspaces.
# AGENT_EXEC_WORKSPACES_ROOT=

# Logging. The app writes rotated JSON-lines logs to LOG_DIR/agent-web.log for
# Aliyun SLS Logtail collection (see agent/ops/sls-logtail-collection.json).
# deploy.ps1 sets LOG_DIR=/opt/personal-assistant/logs on the server; the local
# default is ./logs. Stdout keeps the human-readable pattern for journalctl.
# LOG_DIR=logs
