# LLM API configuration
# Copy this file to .env and fill in real values.
# Environment variables override values in .env.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
# Seconds an answer stream may stay silent before it is aborted as stalled
# (whole seconds; 0 disables the idle watchdog).
# LLM_IDLE_TIMEOUT=90

# Web gateway JWT signing secret (min 32 chars). Required to start :web.
# Generate:  (64 hex chars from a CSPRNG is fine)
AGENT_JWT_SECRET=replace-with-a-long-random-secret-value

# Optional: access-token lifetime (default 2h). Sessions survive this as long as
# they stay active — see AGENT_REFRESH_IDLE_TIMEOUT for the real logout rule.
# AGENT_JWT_TTL=2h

# Optional: log the session out after this long with no authenticated request
# (default 24h). Any API call or token refresh counts as activity.
# AGENT_REFRESH_IDLE_TIMEOUT=24h

# PostgreSQL persistence. Required when AGENT_STORE=postgres (the default).
# The password has no default — put it here, never in source or application.yml.
# The URL must state its TLS intent; use sslmode=require unless the database is local.
AGENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/postgres?sslmode=require
AGENT_DB_USERNAME=postgres
AGENT_DB_PASSWORD=replace-with-your-database-password

# Persistence backend: postgres (default, survives restarts) or memory
# (process-local; history is lost on restart — never use in production).
# AGENT_STORE=postgres

# Optional: customise conversation-memory compression thresholds.
# AGENT_MEMORY_ENABLED=true
# AGENT_MEMORY_MAX_MESSAGES=20
# AGENT_MEMORY_KEEP_MESSAGES=8

# Optional: run the memory summariser on a different (faster/cheaper) model than
# the chat default. Model name alone is enough when only one provider offers it;
# set the provider id too when the name is ambiguous. Falls back to the default
# model when the pair is not on offer.
# AGENT_MEMORY_SUMMARY_PROVIDER=
# AGENT_MEMORY_SUMMARY_MODEL=
