{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Agent Gateway · Turn Timings",
  "uid": "agent-gateway-turns",
  "tags": ["agent-web"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(agent_turn_total_seconds_count, endpoint)",
        "includeAll": true,
        "multi": true,
        "current": { "text": ["stream"], "value": ["stream"] },
        "definition": "label_values(agent_turn_total_seconds_count, endpoint)"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "轮次总耗时 total（均值 / p95）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(agent_turn_total_seconds_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_total_seconds_count{endpoint=~\"$endpoint\"}[5m])", "legendFormat": "avg" },
        { "refId": "B", "expr": "agent_turn_total_seconds{quantile=\"0.95\", endpoint=~\"$endpoint\"}", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "首字延迟 TTFT（均值 / p95）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(agent_turn_llm_ttft_seconds_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_llm_ttft_seconds_count{endpoint=~\"$endpoint\"}[5m])", "legendFormat": "avg" },
        { "refId": "B", "expr": "agent_turn_llm_ttft_seconds{quantile=\"0.95\", endpoint=~\"$endpoint\"}", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM 段耗时（均值 / p95）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(agent_turn_llm_seconds_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_llm_seconds_count{endpoint=~\"$endpoint\"}[5m])", "legendFormat": "avg" },
        { "refId": "B", "expr": "agent_turn_llm_seconds{quantile=\"0.95\", endpoint=~\"$endpoint\"}", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM 轮数 rounds（每轮均值）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(agent_turn_llm_rounds_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_llm_rounds_count{endpoint=~\"$endpoint\"}[5m])", "legendFormat": "rounds/turn" }
      ]
    },
    {
      "type": "timeseries",
      "title": "上下文体积（每次 load 的 chars 与消息数）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(agent_turn_payload_read_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_payload_read_count{endpoint=~\"$endpoint\"}[5m])", "legendFormat": "chars" },
        { "refId": "B", "expr": "rate(agent_turn_messages_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_messages_count{endpoint=~\"$endpoint\"}[5m])", "legendFormat": "messages" }
      ]
    },
    {
      "type": "timeseries",
      "title": "load / persist / list 段耗时（均值）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(agent_turn_load_seconds_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_load_seconds_count{endpoint=~\"$endpoint\"}[5m]) * 1000", "legendFormat": "load" },
        { "refId": "B", "expr": "rate(agent_turn_persist_seconds_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_persist_seconds_count{endpoint=~\"$endpoint\"}[5m]) * 1000", "legendFormat": "persist" },
        { "refId": "C", "expr": "rate(agent_turn_list_seconds_sum{endpoint=~\"$endpoint\"}[5m]) / rate(agent_turn_list_seconds_count{endpoint=~\"$endpoint\"}[5m]) * 1000", "legendFormat": "list" }
      ]
    },
    {
      "type": "timeseries",
      "title": "工具耗时（按工具，每次调用均值）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(agent_turn_tool_seconds_sum[5m]) / rate(agent_turn_tool_seconds_count[5m]) * 1000", "legendFormat": "{{tool}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "记忆压缩（每 5 分钟触发次数）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (fired) (increase(agent_turn_compress_seconds_count[5m]))", "legendFormat": "fired={{fired}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "轮次速率（按 endpoint）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (endpoint) (rate(agent_turn_total_seconds_count[5m]))", "legendFormat": "{{endpoint}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM 堆内存 / 进程 CPU",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cpu %" },
            "properties": [{ "id": "unit", "value": "percent" }]
          }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap" },
        { "refId": "B", "expr": "process_cpu_usage * 100", "legendFormat": "cpu %" }
      ]
    }
  ]
}
